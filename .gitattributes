# Set default behavior to automatically normalize line endings to LF on checkout
* text=auto eol=lf

# Explicit text files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.sha256 text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files - prevent CRLF/LF line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.wasm binary
*.pdf binary
*.zip binary
*.tar.gz binary

