{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qrcraftly",
  "compatibility_date": "2026-10-01",
  // Production is served at qrcraftly.fpderuiter.workers.dev (and qrcraftly.com), and every
  // non-production branch built by Workers Builds gets a <branch>-qrcraftly preview URL.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    // Serve /about/index.html at /about and 308 /about/ to /about, so every URL
    // matches its canonical link (resolvePublicUrl drops trailing slashes).
    "html_handling": "drop-trailing-slash",
    // Unknown paths get a real 404 status with the prerendered 404.html page.
    "not_found_handling": "404-page",
  },
}
