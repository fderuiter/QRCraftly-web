{
  "name": "qrcraftly",
  "description": "A powerful, privacy-focused, and user-friendly React application for generating customized QR codes.",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "pnpm": ">=11.1.3"
  },
  "version": "0.11.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "homepage": "https://qrcraftly.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/fderuiter/QRCraftly.git"
  },
  "keywords": [
    "qr-code",
    "generator",
    "react",
    "privacy-focused",
    "customizable"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/storage_privacy_ast_auditor.js",
    "build": "vite build && pnpm run postbuild",
    "postbuild": "node scripts/write_build_info.js && node scripts/bundle_ast_audit.js && tsx scripts/generate_sitemap.ts && tsx scripts/generate_social_images.ts && node scripts/defer_page_scripts.js && node scripts/csp_hash_injector.js && node scripts/generate_sw.cjs && node scripts/generate_lhci_manifest.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:semgrep": "semgrep --test --config semgrep.yml tests/semgrep/semgrep.tsx --metrics=off --disable-version-check",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "lint": "node scripts/dependency_compliance.js && node scripts/rust_no_deps_check.js && node scripts/git_lineage_auditor.js && node scripts/storage_privacy_ast_auditor.js && node scripts/path_invariance_auditor.js && node scripts/static-path-tracker.js && pnpm run docs:lint && tsc --noEmit && pnpm run lint:boundaries && eslint . --max-warnings 0 && knip && knip --production --include files && node scripts/contrast_check.js && node scripts/design_token_audit.js && prettier --check . && node scripts/check-duplication.js",
    "lint:boundaries": "depcruise src",
    "wasm:build": "node scripts/build_wasm.js",
    "wasm:check": "node scripts/build_wasm.js --check",
    "audit:paths": "node scripts/path_invariance_auditor.js",
    "validate:ui-catalog": "node scripts/validate_ui_catalog.js",
    "validate:duplication": "node scripts/check-duplication.js",
    "docs:sync": "node scripts/sync_docs.js",
    "docs:lint": "node scripts/audit_markdown.js && node scripts/validate_adrs.js && node scripts/validate_ui_catalog.js",
    "licenses:sync": "node scripts/sync_shipped_packages.js",
    "format:classes": "node scripts/sort_tailwind_classes.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-bundle-size": "node scripts/check-bundle-size.js",
    "bench:scanner": "tsx scripts/bench_scanner.ts",
    "bench:wasm": "tsx scripts/bench_wasm.ts",
    "bench:qr-encode": "tsx scripts/bench_qr_encode.ts",
    "bench:transfer": "tsx scripts/bench_transfer.ts",
    "bench:outer-code": "tsx scripts/bench_outer_code.ts",
    "bench:colour": "tsx scripts/bench_colour.ts",
    "bench:optical": "tsx scripts/bench_optical.ts",
    "bench:feedback": "tsx scripts/bench_feedback.ts",
    "bench:optical-ladder": "tsx scripts/bench_optical_ladder.ts",
    "bench:optical-gpu": "tsx scripts/optical_gpu_conformance.ts",
    "resource-quota-report": "node scripts/resource-quota-report.js",
    "secret-scanner": "node scripts/secret-scanner.js",
    "typecheck": "tsc --noEmit",
    "wizard:cloudflare": "node scripts/run_wizard.js setup-cloudflare",
    "wizard:github": "node scripts/run_wizard.js setup-github-ci",
    "wizard:dev": "node scripts/run_wizard.js setup-local-dev",
    "release:dry-run": "node scripts/release_engine.js --dry-run",
    "release:changelog": "node scripts/release_engine.js --generate-changelog",
    "release:prepare": "node scripts/release_engine.js --prepare",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vike": "^0.4.247",
    "vike-react": "^0.6.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "4.13.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.15",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "marked": "^18.0.9",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "6.4.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
